{
  "name": "smart-cab-dispatch-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "docker-compose up -d && npm run dev",
    "dev": "npx concurrently \"npm run dev -w packages/admin-portal\" \"npm run dev -w packages/guest-app\" \"npm run dev -w packages/server\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3"
  }
}
